root = true

[*.cs]

# --------------------
# Formatting
# --------------------
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
insert_final_newline = true

# --------------------
# Usings & namespaces
# --------------------
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error

# --------------------
# Safety & correctness
# --------------------
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_null_propagation = true:error
dotnet_style_coalesce_expression = true:error

# --------------------
# var usage
# --------------------
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion

# --------------------
# Expression-bodied
# --------------------
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent

# --------------------
# Modern C#
# --------------------
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion

# --------------------
# Readonly fields
# --------------------
dotnet_style_readonly_field = true:error

# --------------------
# Noise
# --------------------
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1515.severity = none

# --------------------
# DI/reflection noise
# --------------------
dotnet_diagnostic.CA1812.severity = none

[*.{cs,vb}]
dotnet_diagnostic.CA1716.severity = none

# suppress reuired ConfigureAwait call on awaiting Task
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2234.severity = none

# Записи вызова и отчёты держат адрес строкой ровно как он ушёл в провод,
# экранированным; Uri при чтении переписал бы его. Так же, как в src.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

# Широкий catch в тесте - это утверждение о поведении, а не проглатывание
# ошибки. В src он остаётся ошибкой сборки, см. ниже.
dotnet_diagnostic.CA1031.severity = none


[src/**.cs]
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1720.severity = none

# CA1031 - «не ловить Exception вообще». Единственная механическая защита
# правила «никаких catch (Exception) вокруг вызова API»: без неё запрет живёт
# только в памяти того, кто пишет код, и возвращается молча. Ловить надо
# конкретное - JsonException, HttpRequestException, TaskCanceledException
# с фильтром на собственный токен отмены.
dotnet_diagnostic.CA1031.severity = error